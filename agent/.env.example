# Local development settings. Copy to .env and load with:  set -a; . ./.env; set +a
# (the agent does not read .env files itself; systemd uses deploy/tunnel-agent.env.example)
CONTROL_BASE_URL=http://localhost:5173
AGENT_TOKEN=change-me-change-me-change-me-change-me
AGENT_ID=vm-1
POLL_INTERVAL_SECONDS=60
ENABLE_WEBSOCKET=true
TUNNEL_TARGET_URL=http://localhost:8080
# Point at the fake for development without a real tunnel (needs a launcher; see tests/conftest.py)
CLOUDFLARED_BIN=/usr/bin/cloudflared
TUNNEL_PROTOCOL=auto
TUNNEL_METRICS=127.0.0.1:20241
TUNNEL_START_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1
