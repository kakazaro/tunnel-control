# /etc/tunnel-agent/agent.env  (root:root, mode 600). Plain KEY=value lines, no quotes, no `export`.
# install-agent.sh copies this file only if /etc/tunnel-agent/agent.env does not exist yet.

# Base URL of the Worker, no trailing path. Must be https://.
CONTROL_BASE_URL=https://tunnel-control.your-subdomain.workers.dev
# Same value as the AGENT_TOKEN secret of the Worker (generate with scripts/gen-secret.sh).
AGENT_TOKEN=change-me
# Must match the Worker AGENT_ID.
AGENT_ID=vm-1

# Seconds between syncs (clamped to 10-300; the server may override it).
POLL_INTERVAL_SECONDS=60
# Set to false if a proxy blocks WebSockets (the agent then polls only).
ENABLE_WEBSOCKET=true

TUNNEL_TARGET_URL=http://localhost:8080
CLOUDFLARED_BIN=/usr/bin/cloudflared
# auto | quic | http2. Use http2 if outbound UDP 7844 is blocked.
TUNNEL_PROTOCOL=auto
TUNNEL_METRICS=127.0.0.1:20241
TUNNEL_START_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# Corporate proxy (used by requests, the WebSocket client and cloudflared):
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1
